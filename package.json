{
	"name": "asahi",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"wonderhoy": {
		"name": "Asahi",
		"tagline": "Your whole phone in a browser tab: Android's desktop, screen and apps, Linux apps and machines, online through one USB cable",
		"character": "Asahina Mafuyu",
		"unit": "25-ji, Nightcord de.",
		"color": "#8888CC"
	},
	"scripts": {
		"lint": "biome ci",
		"format": "biome check --write",
		"typecheck": "tsc -p . && pnpm --filter ./web typecheck",
		"theme": "node tools/theme.ts",
		"unify": "node tools/unify.ts",
		"bundle": "node tools/bundle.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@material/material-color-utilities": "0.3.0",
		"@types/node": "26.6.6",
		"@wonderhoy-labs/shiho": "https://github.com/wonderhoy-labs/shiho/releases/download/v0.1.1/wonderhoy-labs-shiho-0.1.1.tgz",
		"@wonderhoy-labs/shira": "https://github.com/wonderhoy-labs/shira/releases/download/v0.3.0/wonderhoy-labs-shira-0.3.0.tgz",
		"@yume-chan/adb": "2.6.4",
		"@yume-chan/stream-extra": "2.6.1",
		"typescript": "7.0.2"
	}
}
